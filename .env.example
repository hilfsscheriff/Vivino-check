# Kopiere nach .env — .env ist in .gitignore und wird nie committed.

# Prodega / Transgourmet Login (deine eigenen Zugangsdaten, deine eigene Kundenkarte)
PRODEGA_USER=
PRODEGA_PASS=

# Alternative zum Login: Session-Cookie aus dem Browser, Format "name=value; name2=value2"
PRODEGA_COOKIE=

# Kontaktangabe im User-Agent. Ohne diese Angabe crawlt das Tool anonym —
# setz eine erreichbare Mailadresse, das ist Teil des Anstands gegenüber den Quellen.
WINECHECK_CONTACT=
