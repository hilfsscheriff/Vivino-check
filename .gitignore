.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
# Die Messdatei von coverage.py ist eine SQLite-Datei und ändert sich bei jedem
# Testlauf. Versioniert stand sie in jedem Diff und verdeckte die echten Änderungen;
# einen Nutzen hat sie nicht, weil sie absolute Pfade dieses Rechners enthält.
.coverage
.coverage.*
cache/
output/
# Nur die Austauschdatei wird versioniert — sie gibt dem GitHub-Wochenlauf die
# Bewertungen mit, die er selbst nicht holen kann (Vivino sperrt dessen IPs).
# Die Verneinung braucht 'state/*': mit 'state/' steigt git gar nicht erst hinein.
state/*
!state/ratings-cache.json
*.sqlite
*.sqlite-journal
.DS_Store
dist/
